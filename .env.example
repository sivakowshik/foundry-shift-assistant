# Copy this file to .env and fill in your own values.
# Never commit .env (it is listed in .gitignore).

# Azure OpenAI v1 endpoint of your Azure OpenAI or Microsoft Foundry resource.
# Example: https://<your-resource-name>.openai.azure.com/openai/v1/
AZURE_OPENAI_BASE_URL=https://<your-resource-name>.openai.azure.com/openai/v1/
AZURE_OPENAI_API_KEY=<your-azure-openai-key>

# The name you gave your chat model deployment (it must support tool calling, e.g. gpt-4o-mini)
AZURE_OPENAI_CHAT_DEPLOYMENT=gpt-4o-mini

# Optional: point at your own CSV files (defaults to the sample data in ./data)
STAFF_CSV=data/staff.csv
ROSTER_CSV=data/roster.csv
